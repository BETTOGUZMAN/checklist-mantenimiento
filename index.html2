  <script type="__bundler/template">
"<!DOCTYPE html>\n<html><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<script src=\"3f7867cf-8dd3-4665-ad66-84df98b84d2c\"><\u002Fscript>\n<\u002Fhead>\n<body>\n<x-dc>\n<helmet>\n<style>/* Modernist — design-system tokens and component classes. This file is the source of truth for the system's look; retune it here and see readme.md. */\n/* vietnamese */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 400;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"3241100f-84df-47f8-8ae1-d5dfe6050e91\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 400;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"75b57b7b-67cc-4628-b92a-aabd6ecabaac\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 400;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"f506a578-f917-41a7-b6b1-c3dd4c1a9e50\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 600;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"3241100f-84df-47f8-8ae1-d5dfe6050e91\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 600;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"75b57b7b-67cc-4628-b92a-aabd6ecabaac\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 600;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"f506a578-f917-41a7-b6b1-c3dd4c1a9e50\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 800;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"3241100f-84df-47f8-8ae1-d5dfe6050e91\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 800;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"75b57b7b-67cc-4628-b92a-aabd6ecabaac\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 800;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"f506a578-f917-41a7-b6b1-c3dd4c1a9e50\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\n\n:root {\n  --color-bg: #f3f2f2;\n  --color-surface: #eae9e9;\n  --color-text: #201e1d;\n  --color-accent: #ec3013;\n  --color-accent-2: #e15b47;\n  --color-divider: color-mix(in srgb, #201e1d 40%, transparent);\n\n  /* Tonal ramps — generated in OKLCH on one shared lightness scale, so the\n     same step of any role matches the others in visual value. */\n  --color-neutral-100: #f8f4f4;\n  --color-neutral-200: #eae7e7;\n  --color-neutral-300: #d7d3d3;\n  --color-neutral-400: #bab6b6;\n  --color-neutral-500: #9b9797;\n  --color-neutral-600: #7d7979;\n  --color-neutral-700: #605d5d;\n  --color-neutral-800: #444141;\n  --color-neutral-900: #2d2b2b;\n\n  --color-accent-100: #fff2ef;\n  --color-accent-200: #ffe0d9;\n  --color-accent-300: #ffc4b8;\n  --color-accent-400: #ff9783;\n  --color-accent-500: #ff563c;\n  --color-accent-600: #dd2b0f;\n  --color-accent-700: #ae1800;\n  --color-accent-800: #7c1405;\n  --color-accent-900: #4d170e;\n\n  --color-accent-2-100: #fff2ef;\n  --color-accent-2-200: #ffe0da;\n  --color-accent-2-300: #ffc4b9;\n  --color-accent-2-400: #ff9784;\n  --color-accent-2-500: #ef6853;\n  --color-accent-2-600: #c94b39;\n  --color-accent-2-700: #9e3526;\n  --color-accent-2-800: #71261b;\n  --color-accent-2-900: #471d16;\n\n  --font-heading: \"Archivo\", system-ui, sans-serif;\n  --font-heading-weight: 800;\n  --font-body: \"Archivo\", system-ui, sans-serif;\n\n  --space-1: 4.0px;\n  --space-2: 8.0px;\n  --space-3: 12.0px;\n  --space-4: 16.0px;\n  --space-6: 24.0px;\n  --space-8: 32.0px;\n\n  --radius-sm: 0px;\n  --radius-md: 0px;\n  --radius-lg: 0px;\n\n  /* Elevation — derived from the ground: soft ink-tinted shadows on a\n     light theme, a hairline edge + ambient darkness on a dark one. */\n  --shadow-sm: 0 1px 2px color-mix(in srgb, #2d2b2b 14%, transparent);\n  --shadow-md: 0 3px 10px color-mix(in srgb, #2d2b2b 16%, transparent);\n  --shadow-lg: 0 12px 32px color-mix(in srgb, #2d2b2b 22%, transparent);\n}\n\nbody {\n  background: var(--color-bg);\n  color: var(--color-text);\n  font-family: var(--font-body);\n}\nh1, h2, h3, h4 { font-family: var(--font-heading); font-weight: var(--font-heading-weight); }\n\n.grayscale{filter:grayscale(1) contrast(1.08)}\n\n/* ══════════════════════════════════════════════════════════════════════════\n   Components — built with the tokens above. Plain CSS\n   on plain HTML: no JavaScript, no build step. Each class is documented in\n   readme.md and demonstrated in foundations/ and components/.\n   ══════════════════════════════════════════════════════════════════════ */\n\n*, *::before, *::after { box-sizing: border-box; }\nbody { margin: 0; font-size: 15px; line-height: 1.55; font-weight: 400; }\nh1, h2, h3, h4, h5, h6 {\n  font-family: var(--font-heading); font-weight: var(--font-heading-weight);\n  line-height: 1.12; letter-spacing: -0.015em; margin: 0 0 var(--space-2);\n}\nh1 { font-size: 42px; }\nh2 { font-size: 32px; }\nh3 { font-size: 25px; }\nh4 { font-size: 20px; }\nh5 { font-size: 16px; }\nh6 { font-size: 13px; }\nh6 { letter-spacing: 0.08em; text-transform: uppercase; }\np { margin: 0 0 var(--space-3); }\na { color: var(--color-accent); text-underline-offset: 3px; }\nimg { display: block; max-width: 100%; }\nfigure { margin: 0; }\nfigcaption {\n  font-size: 11px; margin-top: var(--space-1);\n  color: color-mix(in srgb, var(--color-text) 55%, transparent);\n}\n.text-muted { color: color-mix(in srgb, var(--color-text) 55%, transparent); }\n:focus { outline: none; }\n:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }\n::selection { background: color-mix(in srgb, var(--color-accent) 30%, transparent); }\n\n/* — rules — */\n.hr {\n  height: 2px; border: 0; margin: var(--space-4) 0;\n  background: var(--color-divider);\n}\n\n/* — buttons — */\n.btn {\n  display: inline-flex; align-items: center; justify-content: center; gap: 6px;\n  cursor: pointer; text-decoration: none;\n  font-family: var(--font-heading); font-weight: var(--font-heading-weight);\n  font-size: 14px; line-height: 1.2; color: var(--color-text); /* matches the .input's 14px —\n     the pair sits side by side in sign-up rows */\n  background: transparent; border: 1px solid transparent;\n  padding: var(--space-2) calc(var(--space-3) * 1.2);\n  border-radius: var(--radius-md);\n}\n.btn svg { display: block; }\n.btn:disabled { opacity: 0.45; cursor: not-allowed; }\n.btn-primary { background: var(--color-accent); color: var(--color-bg); }\n.btn-primary:hover { background: var(--color-accent-600); }\n.btn-primary:active { background: var(--color-accent-700); }\n.btn-secondary { border-color: var(--color-divider); }\n.btn-secondary:hover { background: color-mix(in srgb, var(--color-text) 7%, transparent); }\n.btn-secondary:active { background: color-mix(in srgb, var(--color-text) 14%, transparent); }\n.btn-ghost { color: var(--color-accent); padding-inline: var(--space-1); }\n.btn-ghost:hover { background: color-mix(in srgb, var(--color-accent) 10%, transparent); }\n.btn-ghost:active { background: color-mix(in srgb, var(--color-accent) 18%, transparent); }\n.btn-icon { width: 36px; height: 36px; padding: 0; }\n.btn-block { width: 100%; margin-top: var(--space-2); justify-content: flex-start; text-align: left; }\n\n/* — forms — */\n.field > label {\n  display: block; font-size: 12px; margin-bottom: 5px;\n  color: color-mix(in srgb, var(--color-text) 70%, transparent);\n}\n.input {\n  width: 100%; min-height: 36px; padding: 6px 10px; font: inherit;\n  font-size: 14px; color: var(--color-text); caret-color: var(--color-accent);\n  background: var(--color-surface);\n  border: 1px solid var(--color-divider); border-radius: var(--radius-md);\n}\n.input:hover { border-color: color-mix(in srgb, var(--color-text) 45%, transparent); }\n.input:focus-visible { border-color: var(--color-accent); outline-offset: 0; }\ntextarea.input { min-height: 90px; resize: vertical; }\n.radio { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-size: 14px; }\n.radio input, .seg-opt input {\n  position: absolute; opacity: 0; width: 0; height: 0; pointer-events: none;\n}\n.radio .dot {\n  width: 16px; height: 16px; flex: none; border-radius: 50%;\n  border: 1.5px solid var(--color-divider);\n}\n.radio:hover .dot { border-color: var(--color-accent); }\n.radio input:checked + .dot {\n  border-color: var(--color-accent); background: var(--color-accent);\n  box-shadow: inset 0 0 0 4px var(--color-bg);\n}\n.radio input:focus-visible + .dot { outline: 2px solid var(--color-accent); outline-offset: 2px; }\n.seg {\n  display: inline-flex; overflow: hidden;\n  border: 1px solid var(--color-divider); border-radius: var(--radius-md);\n}\n.seg-opt {\n  display: inline-flex; align-items: center; gap: 6px;\n  padding: 7px 12px; font-size: 13px; cursor: pointer;\n}\n.seg-opt + .seg-opt { border-left: 1px solid var(--color-divider); }\n.seg-opt:has(input:checked) { background: var(--color-accent); color: var(--color-bg); }\n.seg-opt:not(:has(input:checked)):hover { background: color-mix(in srgb, var(--color-text) 7%, transparent); }\n.seg-opt:has(input:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: -2px; }\n\n/* — cards — */\n.card {\n  display: flex; flex-direction: column; gap: var(--space-2);\n  padding: var(--space-3); border-radius: var(--radius-md); background: var(--color-surface);\n}\n.card-kicker { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent); }\n.card-title {\n  font-family: var(--font-heading); font-weight: var(--font-heading-weight);\n  font-size: 17px; line-height: 1.2;\n}\n.card-body { margin: 0; font-size: 13px; opacity: 0.8; flex: 1; }\n.card-meta {\n  display: flex; align-items: center; gap: 6px; font-size: 11px;\n  color: color-mix(in srgb, var(--color-text) 50%, transparent);\n}\n.elev-sm { box-shadow: var(--shadow-sm); }\n.elev-md { box-shadow: var(--shadow-md); }\n.elev-lg { box-shadow: var(--shadow-lg); }\n\n/* — tags — */\n.tag {\n  display: inline-flex; align-items: center; font-size: 11px;\n  letter-spacing: 0.02em; padding: 3px 10px;\n  border-radius: calc(var(--radius-md) * 0.75);\n}\n.tag-accent { background: var(--color-accent-100); color: var(--color-accent-800); }\n.tag-accent-2 { background: var(--color-accent-2-100); color: var(--color-accent-2-800); }\n.tag-neutral { background: var(--color-neutral-100); color: var(--color-neutral-800); }\n.tag-outline { border: 1px solid var(--color-accent); color: var(--color-accent); }\n\n/* — navigation — */\n.nav {\n  display: flex; align-items: center; gap: var(--space-4);\n  padding: var(--space-3) var(--space-4);\n  border-bottom: 2px solid var(--color-divider);\n}\n.nav-brand {\n  font-family: var(--font-heading); font-weight: var(--font-heading-weight);\n  font-size: 18px; margin-right: auto;\n}\n.nav a { color: inherit; text-decoration: none; font-size: 14px; }\n.nav a:hover, .nav a[aria-current='page'] { color: var(--color-accent); }\n\n/* — tables — */\n.table { width: 100%; border-collapse: collapse; font-size: 14px; }\n.table th {\n  text-align: left; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;\n  color: color-mix(in srgb, var(--color-text) 60%, transparent);\n  padding: var(--space-2); border-bottom: 2px solid var(--color-divider);\n}\n.table td {\n  padding: var(--space-2);\n  border-bottom: 1px solid var(--color-divider);\n}\n.table tbody tr:hover { background: color-mix(in srgb, var(--color-text) 4%, transparent); }\n\n/* — dialog — */\n.dialog-backdrop {\n  position: fixed; inset: 0; display: grid; place-items: center;\n  padding: var(--space-4);\n  background: color-mix(in srgb, var(--color-neutral-900) 50%, transparent);\n}\n.dialog {\n  width: min(440px, 100%); display: flex; flex-direction: column; gap: var(--space-3);\n  padding: var(--space-4); border-radius: var(--radius-lg);\n  background: var(--color-surface); box-shadow: var(--shadow-lg);\n}\n.dialog-title {\n  font-family: var(--font-heading); font-weight: var(--font-heading-weight);\n  font-size: 20px;\n}\n.dialog-body { font-size: 14px; opacity: 0.85; }\n.dialog-actions { display: flex; justify-content: flex-end; gap: var(--space-2); margin-top: var(--space-2); }\n\n<\u002Fstyle>\n<script src=\"f3d16e79-de76-4a56-bd0c-b5ed9e43b952\"><\u002Fscript>\n<script src=\"1cd240b9-8195-4890-a712-734a827bfe96\"><\u002Fscript>\n<style>body{margin:0;background:var(--color-surface);font-family:var(--font-body)}a{color:var(--color-accent-700)}a:hover{color:var(--color-accent-800)}textarea,input,button{font-family:var(--font-body)}<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"min-height:100vh;display:flex;justify-content:center;align-items:flex-start;padding:32px 16px\">\n<div style=\"width:390px;max-width:100%;height:820px;display:flex;flex-direction:column;position:relative;background:var(--color-bg);border:2px solid var(--color-text);overflow:hidden;box-shadow:var(--shadow-lg)\">\n\n  <div style=\"padding:12px 14px;display:flex;align-items:center;border-bottom:2px solid var(--color-text);background:#fff\">\n    <img src=\"6526cfcd-11c7-46b8-8a03-4d7b8e38e9d1\" alt=\"Zijin · Continental Gold — Minería Moderna\" style=\"height:36px;width:auto;display:block\">\n  <\u002Fdiv>\n  <div style=\"padding:14px 14px 0;display:flex;flex-direction:column;gap:8px;border-bottom:2px solid var(--color-text)\">\n    <div style=\"display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--color-neutral-700)\">\n      <span>{{ code }} · {{ interval }}<\u002Fspan>\n      <span style=\"display:flex;align-items:center;gap:5px\"><svg width=\"13\" height=\"13\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M12 20h.01\"><\u002Fpath><path d=\"M8.5 16.429a5 5 0 0 1 7 0\"><\u002Fpath><path d=\"M5 12.859a10 10 0 0 1 5.17-2.69\"><\u002Fpath><path d=\"M19 12.859a10 10 0 0 0-2.007-1.523\"><\u002Fpath><path d=\"M2 8.82a15 15 0 0 1 4.177-2.643\"><\u002Fpath><path d=\"M22 8.82a15 15 0 0 0-11.288-3.764\"><\u002Fpath><path d=\"m2 2 20 20\"><\u002Fpath><\u002Fsvg>Sin conexión<\u002Fspan>\n    <\u002Fdiv>\n    <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:12px\">\n      <div style=\"font:800 22px/1.1 var(--font-heading);letter-spacing:-.015em\">{{ modelName }}<\u002Fdiv>\n      <div style=\"font:600 13px var(--font-body);white-space:nowrap\">{{ doneCount }} / {{ total }} · {{ pct }}%<\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"height:6px;background:var(--color-neutral-300)\"><div style=\"height:6px;background:var(--color-accent);width:{{ pct }}%;transition:width .3s\"><\u002Fdiv><\u002Fdiv>\n    <div style=\"display:grid;grid-template-columns:repeat(2,1fr);margin:6px -14px 0\">\n      <sc-for list=\"{{ tabs }}\" as=\"t\" hint-placeholder-count=\"3\">\n        <button sc-camel-on-click=\"{{ t.go }}\" style=\"height:44px;border:0;border-top:2px solid var(--color-text);border-right:{{ t.br }};background:{{ t.bg }};color:{{ t.fg }};font:600 13px var(--font-body);text-align:left;padding:0 14px;cursor:pointer\">{{ t.label }}<\u002Fbutton>\n      <\u002Fsc-for>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <sc-if value=\"{{ isDatos }}\" hint-placeholder-val=\"{{ true }}\">\n    <div style=\"flex:1;overflow-y:auto;padding:18px 14px 24px;display:flex;flex-direction:column;gap:16px\">\n      <label style=\"display:flex;flex-direction:column;gap:6px\">\n        <span style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:600\">Equipo / hoja de ruta<\u002Fspan>\n        <sc-raw-select value=\"{{ modelCode }}\" sc-camel-on-change=\"{{ onModel }}\" style=\"height:52px;border:2px solid var(--color-text);border-radius:0;background:var(--color-bg);color:var(--color-text);font:600 15px var(--font-body);padding:0 12px;width:100%\">\n          <sc-for list=\"{{ models }}\" as=\"m\" hint-placeholder-count=\"0\"><option value=\"{{ m.code }}\">{{ m.label }}<\u002Foption><\u002Fsc-for>\n        <\u002Fsc-raw-select>\n      <\u002Flabel>\n      <div style=\"display:flex;flex-direction:column;gap:6px\">\n        <span style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:600\">Intervalo de mantenimiento<\u002Fspan>\n        <div style=\"display:grid;grid-template-columns:repeat(4,1fr);border-top:2px solid var(--color-text);border-left:2px solid var(--color-text)\">\n          <sc-for list=\"{{ intervals }}\" as=\"iv\" hint-placeholder-count=\"7\">\n            <button sc-camel-on-click=\"{{ iv.pick }}\" style=\"height:56px;border:0;border-right:2px solid var(--color-text);border-bottom:2px solid var(--color-text);background:{{ iv.bg }};color:{{ iv.fg }};text-align:left;padding:6px 10px;cursor:pointer;display:flex;flex-direction:column;justify-content:space-between\">\n              <span style=\"font:800 16px var(--font-heading)\">{{ iv.name }}<\u002Fspan>\n              <span style=\"font-size:10.5px;opacity:.8\">{{ iv.sub }}<\u002Fspan>\n            <\u002Fbutton>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;border-top:2px solid var(--color-text);border-left:2px solid var(--color-text)\">\n        <sc-for list=\"{{ fixedData }}\" as=\"f\" hint-placeholder-count=\"4\">\n          <div style=\"padding:9px 12px;border-right:2px solid var(--color-text);border-bottom:2px solid var(--color-text)\">\n            <div style=\"font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--color-neutral-700)\">{{ f.k }}<\u002Fdiv>\n            <div style=\"font-weight:600;font-size:14px\">{{ f.v }}<\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n      <sc-for list=\"{{ fields }}\" as=\"f\" hint-placeholder-count=\"5\">\n        <label style=\"display:flex;flex-direction:column;gap:6px\">\n          <span style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:600\">{{ f.label }}<\u002Fspan>\n          <input class=\"input\" value=\"{{ f.value }}\" sc-camel-on-change=\"{{ f.onChange }}\" placeholder=\"{{ f.ph }}\" sc-camel-input-mode=\"{{ f.mode }}\" type=\"{{ f.type }}\" style=\"height:48px;font-size:16px;width:100%\">\n        <\u002Flabel>\n      <\u002Fsc-for>\n      <button class=\"btn btn-primary btn-block\" sc-camel-on-click=\"{{ goCheck }}\" style=\"height:52px;justify-content:space-between;font-size:15px\">Iniciar checklist {{ interval }}<svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M5 12h14\"><\u002Fpath><path d=\"m12 5 7 7-7 7\"><\u002Fpath><\u002Fsvg><\u002Fbutton>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ isCheck }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"display:grid;grid-template-columns:1fr auto;align-items:center;gap:8px;padding:8px 14px;border-bottom:2px solid var(--color-text)\">\n      <div style=\"display:grid;grid-template-columns:repeat(3,auto);justify-content:start;border:2px solid var(--color-text)\">\n        <sc-for list=\"{{ filters }}\" as=\"fl\" hint-placeholder-count=\"3\">\n          <button sc-camel-on-click=\"{{ fl.go }}\" style=\"height:34px;border:0;border-right:{{ fl.br }};background:{{ fl.bg }};color:{{ fl.fg }};font:600 12px var(--font-body);text-align:left;padding:0 10px;cursor:pointer\">{{ fl.label }}<\u002Fbutton>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n      <button class=\"btn btn-secondary\" sc-camel-on-click=\"{{ allGood }}\" style=\"height:38px;font-size:12px;padding:0 10px\">Pendientes → B<\u002Fbutton>\n    <\u002Fdiv>\n    <div style=\"display:grid;grid-template-columns:1fr 38px 38px 38px;background:var(--color-text);color:#fff;font:600 11px var(--font-body);letter-spacing:.06em\">\n      <span style=\"padding:6px 14px\">TAREA<\u002Fspan><span style=\"padding:6px 0 6px 8px\">B<\u002Fspan><span style=\"padding:6px 0 6px 8px\">R<\u002Fspan><span style=\"padding:6px 0 6px 8px\">M<\u002Fspan>\n    <\u002Fdiv>\n    <div style=\"flex:1;overflow-y:auto\">\n      <sc-if value=\"{{ emptyFilter }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"padding:24px 14px;font-size:14px;color:var(--color-neutral-700)\">{{ emptyMsg }}<\u002Fdiv><\u002Fsc-if>\n      <sc-for list=\"{{ sections }}\" as=\"sec\" hint-placeholder-count=\"6\">\n        <div style=\"padding:8px 14px;background:var(--color-neutral-200);border-bottom:2px solid var(--color-text);display:flex;justify-content:space-between;gap:8px;font:800 12px var(--font-heading);letter-spacing:.06em;position:sticky;top:0;z-index:1\"><span>{{ sec.name }}<\u002Fspan><span style=\"font-weight:600;color:{{ sec.cfg }}\">{{ sec.done }}/{{ sec.count }}{{ sec.flag }}<\u002Fspan><\u002Fdiv>\n        <sc-for list=\"{{ sec.items }}\" as=\"it\" hint-placeholder-count=\"4\">\n          <div style=\"border-bottom:1px solid var(--color-divider)\">\n            <div style=\"display:grid;grid-template-columns:1fr 38px 38px 38px\">\n              <button sc-camel-on-click=\"{{ it.toggleRow }}\" style=\"border:0;background:transparent;text-align:left;padding:8px 8px 8px 14px;font:400 12.5px/1.35 var(--font-body);color:var(--color-text);cursor:pointer;display:flex;gap:6px\">\n                <span style=\"font-weight:600;color:var(--color-neutral-700);min-width:18px\">{{ it.code }}<\u002Fspan>\n                <span style=\"display:flex;flex-direction:column;gap:2px\"><span>{{ it.text }}<\u002Fspan><span style=\"font-size:11px;color:{{ it.metaColor }}\">{{ it.meta }}<\u002Fspan><\u002Fspan>\n              <\u002Fbutton>\n              <sc-for list=\"{{ it.opts }}\" as=\"o\" hint-placeholder-count=\"3\">\n                <button sc-camel-on-click=\"{{ o.pick }}\" aria-label=\"{{ o.full }}\" style=\"border:0;border-left:1px solid var(--color-divider);background:{{ o.bg }};color:{{ o.fg }};font:800 14px var(--font-heading);cursor:pointer;padding:0;min-height:48px\">{{ o.mark }}<\u002Fbutton>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n            <sc-if value=\"{{ it.rowOpen }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"padding:4px 14px 12px;display:flex;flex-direction:column;gap:8px\">\n                <sc-if value=\"{{ it.measure }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"display:grid;grid-template-columns:1fr auto;border:2px solid var(--color-text)\"><input value=\"{{ it.val }}\" sc-camel-on-change=\"{{ it.onVal }}\" sc-camel-input-mode=\"decimal\" placeholder=\"Valor observado\" style=\"height:44px;border:0;padding:0 10px;font-size:16px;background:transparent;outline-offset:-2px\"><span style=\"padding:0 12px;display:flex;align-items:center;background:var(--color-neutral-200);font:600 12px var(--font-body)\">{{ it.unit }}<\u002Fspan><\u002Fdiv>\n                <\u002Fsc-if>\n                <div style=\"display:grid;grid-template-columns:1fr 44px;gap:6px\">\n                  <input value=\"{{ it.note }}\" sc-camel-on-change=\"{{ it.onNote }}\" placeholder=\"{{ it.notePh }}\" style=\"height:44px;border:2px solid {{ it.noteBd }};padding:0 10px;font-size:16px;background:{{ it.noteBg }}\">\n                  <label title=\"Agregar foto\" style=\"height:44px;border:2px solid var(--color-text);display:flex;align-items:center;justify-content:center;cursor:pointer\"><svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z\"><\u002Fpath><circle cx=\"12\" cy=\"13\" r=\"3\"><\u002Fcircle><\u002Fsvg><input type=\"file\" accept=\"image/*\" capture=\"environment\" sc-camel-on-change=\"{{ it.onPhoto }}\" style=\"display:none\"><\u002Flabel>\n                <\u002Fdiv>\n                <sc-if value=\"{{ it.hasPhotos }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"display:flex;gap:6px;flex-wrap:wrap\"><sc-for list=\"{{ it.photos }}\" as=\"p\" hint-placeholder-count=\"0\"><button sc-camel-on-click=\"{{ p.remove }}\" title=\"Quitar foto\" style=\"width:56px;height:56px;padding:0;cursor:pointer;border:2px solid var(--color-text);background:center/cover no-repeat url({{ p.src }})\"><\u002Fbutton><\u002Fsc-for><\u002Fdiv><\u002Fsc-if>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fsc-for>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ toastOn }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"position:absolute;left:14px;right:14px;bottom:76px;background:var(--color-text);color:#fff;padding:12px 14px;font-size:14px\">{{ toast }}<\u002Fdiv>\n  <\u002Fsc-if>\n<\u002Fdiv>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\">\nclass Component extends DCLogic {\n  state = this.load() || { model: 'CG-GA-PM-RS-008', interval: '125 H', meta: { equipo: '', horo: '', orden: '', fecha: new Date().toISOString().slice(0, 10), ejecutor: '' }, by: {}, sig: null };\n  ui = { tab: 'datos', rows: {}, filter: 'all', toast: '' };\n  load() { try { return JSON.parse(localStorage.getItem('rutas-v3')); } catch (e) { return null; } }\n  componentDidMount() { if (!window.ROUTE_DATA) this._t = setInterval(() => { if (window.ROUTE_DATA) { clearInterval(this._t); this.forceUpdate(); } }, 100); }\n  componentDidUpdate() {\n    try { localStorage.setItem('rutas-v3', JSON.stringify(this.state)); }\n    catch (e) { try { const by = {}; Object.entries(this.state.by).forEach(([k, v]) => { by[k] = { ...v, ans: Object.fromEntries(Object.entries(v.ans || {}).map(([i, a]) => [i, { ...a, photos: [] }])) }; }); localStorage.setItem('rutas-v3', JSON.stringify({ ...this.state, by })); this.flash('Memoria llena: las fotos no se guardaron sin conexión.'); } catch (e2) {} }\n  }\n  setUi(p) { Object.assign(this.ui, p); this.forceUpdate(); }\n  key(s) { return s.model + '|' + s.interval; }\n  cur(s) { return s.by[this.key(s)] || { ans: {}, ins: {}, tools: {}, obs: '' }; }\n  setCur(fn) { this.setState(s => { const c = this.cur(s); return { by: { ...s.by, [this.key(s)]: { ...c, ...fn(c) } } }; }); }\n  setAns(id, p) { this.setCur(c => ({ ans: { ...c.ans, [id]: { ...(c.ans[id] || {}), ...p } } })); }\n  flash(msg) { this.setUi({ toast: msg }); clearTimeout(this._toast); this._toast = setTimeout(() => this.setUi({ toast: '' }), 2800); }\n  sigRef = (el) => {\n    if (!el || el === this._canvas) return; this._canvas = el;\n    const ctx = el.getContext('2d'); ctx.lineWidth = 4; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.strokeStyle = '#201e1d';\n    if (this.state.sig) { const im = new Image(); im.onload = () => ctx.drawImage(im, 0, 0); im.src = this.state.sig; }\n    let down = false;\n    const pt = e => { const r = el.getBoundingClientRect(); return [(e.clientX - r.left) * el.width / r.width, (e.clientY - r.top) * el.height / r.height]; };\n    el.addEventListener('pointerdown', e => { down = true; el.setPointerCapture(e.pointerId); ctx.beginPath(); ctx.moveTo(...pt(e)); });\n    el.addEventListener('pointermove', e => { if (!down) return; ctx.lineTo(...pt(e)); ctx.stroke(); });\n    el.addEventListener('pointerup', () => { down = false; this.setState({ sig: el.toDataURL() }); });\n  };\n  readPhoto(id, e) {\n    const f = e.target.files && e.target.files[0]; if (!f) return;\n    const r = new FileReader();\n    r.onload = () => { const im = new Image(); im.onload = () => { const c = document.createElement('canvas'); const k = Math.min(1, 640 / Math.max(im.width, im.height)); c.width = im.width * k; c.height = im.height * k; c.getContext('2d').drawImage(im, 0, 0, c.width, c.height); const url = c.toDataURL('image/jpeg', .7); this.setCur(cc => ({ ans: { ...cc.ans, [id]: { ...(cc.ans[id] || {}), photos: [...((cc.ans[id] || {}).photos || []), url] } } })); }; im.src = r.result; };\n    r.readAsDataURL(f); e.target.value = '';\n  }\n  exportPdf(D, iv, flat) {\n    const st = this.state, m = st.meta, c = this.cur(st), L = { B: 'Bueno', R: 'Regular', M: 'Malo' };\n    const esc = s => String(s == null ? '' : s).replace(/[&<>]/g, x => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[x]));\n    const SC = 'scr' + 'ipt';\n    let rows = '';\n    iv.sections.forEach(([name], si) => {\n      rows += `<tr><th colspan=\"6\" style=\"text-align:left;background:#eae9e9\">${esc(name)}<\u002Fth><\u002Ftr>`;\n      flat.filter(i => i.si === si).forEach(i => { const a = c.ans[i.id] || {}; rows += `<tr><td>${i.code}<\u002Ftd><td>${esc(i.text)}${a.val ? ` <b>[${esc(a.val)} ${i.unit}]<\u002Fb>` : ''}<\u002Ftd><td>${i.time}<\u002Ftd><td>${esc(i.spec)}<\u002Ftd><td style=\"${a.s === 'M' ? 'background:#ffe0d9;font-weight:bold' : ''}\">${L[a.s] || '—'}<\u002Ftd><td>${esc(a.note)}${(a.photos || []).map(p => `<img src=\"${p}\" style=\"height:60px;margin:2px\">`).join('')}<\u002Ftd><\u002Ftr>`; });\n    });\n    const yn = v => v === true ? 'Sí' : v === false ? 'No' : '—';\n    const ins = iv.insumos.map(([pn, d, q, u], k) => `<tr><td>${esc(pn)}<\u002Ftd><td>${esc(d)}<\u002Ftd><td>${esc(q)} ${esc(u)}<\u002Ftd><td>${yn(c.ins[k])}<\u002Ftd><\u002Ftr>`).join('');\n    const tl = iv.tools.map(([d, q], k) => `<tr><td>${k + 1}<\u002Ftd><td>${esc(d)}<\u002Ftd><td>${esc(q)}<\u002Ftd><td>${yn(c.tools[k])}<\u002Ftd><\u002Ftr>`).join('');\n    const html = `<!doctype html><html><head><meta charset=\"utf-8\"><title>Informe ${D.code} ${D.name} ${st.interval} ${esc(m.equipo)}<\u002Ftitle><style>body{font:11px Archivo,Arial,sans-serif;color:#201e1d;margin:20px}h1{font-size:16px;margin:0}h3{margin:16px 0 4px}table{border-collapse:collapse;width:100%;margin:6px 0}td,th{border:1px solid #201e1d;padding:3px 5px;vertical-align:top}.h{display:grid;grid-template-columns:repeat(3,1fr);gap:3px 16px;margin:8px 0;border-top:2px solid #201e1d;padding-top:6px}<\u002Fstyle><\u002Fhead><body><h1>MANTENIMIENTO PREVENTIVO ${st.interval} · ${esc(D.name)}<\u002Fh1><div>${D.code} · Edition No.01<\u002Fdiv><div class=\"h\"><div>Descripción: ${D.desc}<\u002Fdiv><div>Modelo: ${D.model}<\u002Fdiv><div>Ubicación: ${D.location}<\u002Fdiv><div>Código equipo: ${esc(m.equipo)}<\u002Fdiv><div>Horómetro: ${esc(m.horo)} h<\u002Fdiv><div>No. Orden: ${esc(m.orden)}<\u002Fdiv><div>Fecha ejecución: ${esc(m.fecha)}<\u002Fdiv><div>Duración estimada: ${iv.est} h<\u002Fdiv><div>Ejecutado por: ${esc(m.ejecutor)}<\u002Fdiv><\u002Fdiv><table><tr><th>Tarea<\u002Fth><th>Descripción<\u002Fth><th>T. est. [h]<\u002Fth><th>Especialidad<\u002Fth><th>Estado<\u002Fth><th>Observaciones<\u002Fth><\u002Ftr>${rows}<\u002Ftable><h3>Insumos<\u002Fh3><table><tr><th>Parte Número<\u002Fth><th>Descripción<\u002Fth><th>Cantidad<\u002Fth><th>Cambio<\u002Fth><\u002Ftr>${ins}<\u002Ftable><h3>Herramientas especiales<\u002Fh3><table><tr><th>Item<\u002Fth><th>Descripción<\u002Fth><th>Cantidad<\u002Fth><th>Sí/No<\u002Fth><\u002Ftr>${tl}<\u002Ftable><h3>Observaciones adicionales<\u002Fh3><p>${esc(c.obs)}<\u002Fp><div style=\"display:flex;gap:60px;margin-top:20px\"><div>${st.sig ? `<img src=\"${st.sig}\" style=\"height:80px\">` : '<div style=\"height:80px\"><\u002Fdiv>'}<div style=\"border-top:1px solid #000;width:240px\">EJECUTANTE · ${esc(m.ejecutor)}<\u002Fdiv><\u002Fdiv><div><div style=\"height:80px\"><\u002Fdiv><div style=\"border-top:1px solid #000;width:240px\">SUPERVISOR<\u002Fdiv><\u002Fdiv><\u002Fdiv><${SC}>onload=()=>setTimeout(()=>print(),300)<\u002F${SC}><\u002Fbody><\u002Fhtml>`;\n    const w = window.open(URL.createObjectURL(new Blob([html], { type: 'text/html' })), '_blank');\n    this.flash(w ? 'Informe generado. Elige \"Guardar como PDF\" al imprimir.' : 'Permite ventanas emergentes para generar el PDF.');\n  }\n  renderVals() {\n    const st = this.state, ui = this.ui, c = this.cur(st);\n    const RD = window.ROUTE_DATA || { models: [] };\n    const D = RD.models.find(x => x.code === st.model) || RD.models[0] || { code: '', name: '', intervals: {} };\n    if (D.code && !D.intervals[st.interval]) { const first = Object.keys(D.intervals)[0]; if (first && first !== st.interval) setTimeout(() => this.setState({ interval: first }), 0); }\n    const iv = D.intervals[st.interval] || { sections: [], insumos: [], tools: [], est: 0 };\n    const TN = { 10: 'Limpieza', 20: 'Inspección', 30: 'Sustitución', 40: 'Ajuste', 50: 'Lubricación', 80: 'Calibración' };\n    const flat = [];\n    iv.sections.forEach(([name, items], si) => items.forEach(([code, text, time, spec, unit], ii) => flat.push({ id: si + '-' + ii, si, secName: name, code, typeName: TN[code] || '', text, time, spec, unit, measure: !!unit })));\n    const total = flat.length;\n    const A = i => c.ans[i.id] || {};\n    const doneCount = flat.filter(i => A(i).s).length;\n    const pct = total ? Math.round(doneCount / total * 100) : 0;\n    const sty = { B: ['var(--color-text)', '#fff'], R: ['var(--color-accent-200)', 'var(--color-accent-800)'], M: ['var(--color-accent)', '#fff'] };\n    const vm = i => {\n      const a = A(i), photos = a.photos || [], bad = a.s === 'R' || a.s === 'M';\n      const metaParts = [i.typeName, i.time + ' h']; if (i.spec && i.spec !== 'Mecánico') metaParts.push(i.spec);\n      if (a.val) metaParts.push(`${a.val} ${i.unit}`); else if (i.measure) metaParts.push(`Apuntar ${i.unit}`);\n      if (photos.length) metaParts.push(photos.length + (photos.length > 1 ? ' fotos' : ' foto')); if (a.note) metaParts.push('obs.');\n      return { ...i, val: a.val || '', note: a.note || '', meta: metaParts.join(' · '), metaColor: bad && !a.note ? 'var(--color-accent-700)' : 'var(--color-neutral-700)',\n        photos: photos.map((src, k) => ({ src, remove: () => this.setAns(i.id, { photos: photos.filter((_, j) => j !== k) }) })), hasPhotos: photos.length > 0,\n        rowOpen: !!ui.rows[i.id] || bad,\n        notePh: bad ? 'Observación obligatoria' : 'Observaciones', noteBd: bad ? 'var(--color-accent)' : 'var(--color-text)', noteBg: bad ? 'var(--color-accent-100)' : 'transparent',\n        toggleRow: () => this.setUi({ rows: { ...ui.rows, [i.id]: !ui.rows[i.id] } }),\n        onVal: e => this.setAns(i.id, { val: e.target.value }), onNote: e => this.setAns(i.id, { note: e.target.value }),\n        onPhoto: e => this.readPhoto(i.id, e),\n        opts: [['B', 'Bueno'], ['R', 'Regular'], ['M', 'Malo']].map(([k, full]) => { const on = a.s === k; return { mark: k, full, bg: on ? sty[k][0] : 'transparent', fg: on ? sty[k][1] : 'var(--color-neutral-400)', pick: () => this.setAns(i.id, { s: on ? undefined : k }) }; }) };\n    };\n    const keep = i => ui.filter === 'all' ? true : ui.filter === 'pend' ? !A(i).s : ['R', 'M'].includes(A(i).s);\n    const sections = iv.sections.map(([name], si) => {\n      const its = flat.filter(i => i.si === si); const done = its.filter(i => A(i).s).length;\n      const bad = its.filter(i => ['R', 'M'].includes(A(i).s)).length;\n      return { name, count: its.length, done, flag: bad ? ` · ${bad} hall.` : '', cfg: bad ? 'var(--color-accent-700)' : 'var(--color-text)', items: its.filter(keep).map(vm) };\n    }).filter(s => s.items.length);\n    const tabs = [['datos', 'Datos'], ['check', 'Checklist']].map(([k, label], n) => ({ label, go: () => this.setUi({ tab: k }), bg: ui.tab === k ? 'var(--color-text)' : 'transparent', fg: ui.tab === k ? '#fff' : 'var(--color-text)', br: n < 1 ? '2px solid var(--color-text)' : '0' }));\n    const cnt = k => flat.filter(i => A(i).s === k).length;\n    const pending = total - doneCount, nBad = cnt('R') + cnt('M');\n    const filters = [['all', 'Todas'], ['pend', `Pend. ${pending}`], ['bad', `Hall. ${nBad}`]].map(([k, label], n) => ({ label, go: () => this.setUi({ filter: k }), bg: ui.filter === k ? 'var(--color-text)' : 'transparent', fg: ui.filter === k ? '#fff' : 'var(--color-text)', br: n < 2 ? '2px solid var(--color-text)' : '0' }));\n    const m = st.meta; const setM = k => e => this.setState({ meta: { ...st.meta, [k]: e.target.value } });\n    const fields = [['Código equipo', 'equipo', 'Ej. DT-12', 'text', 'text'], ['Horómetro (h)', 'horo', '0', 'decimal', 'text'], ['No. orden', 'orden', 'OT-', 'text', 'text'], ['Fecha ejecución', 'fecha', '', 'text', 'date'], ['Ejecutado por', 'ejecutor', 'Nombre del mecánico', 'text', 'text']].map(([label, k, ph, mode, type]) => ({ label, value: m[k] || '', onChange: setM(k), ph, mode, type }));\n    const intervals = Object.keys(D.intervals).map(name => { const on = name === st.interval; const b = st.by[D.code + '|' + name]; const n = D.intervals[name].sections.reduce((t, s) => t + s[1].length, 0); const d = b ? Object.values(b.ans || {}).filter(a => a.s).length : 0; return { name, sub: d ? `${d}/${n}` : `${n} tareas`, bg: on ? 'var(--color-text)' : 'transparent', fg: on ? '#fff' : 'var(--color-text)', pick: () => { this.ui.rows = {}; this.setState({ interval: name }); } }; });\n    const findings = flat.filter(i => ['M', 'R'].includes(A(i).s)).sort((x, y) => (A(x).s === 'M' ? 0 : 1) - (A(y).s === 'M' ? 0 : 1)).map(i => { const a = A(i); return { s: a.s === 'M' ? 'MALO' : 'REG.', bg: sty[a.s][0], fg: sty[a.s][1], sec: i.secName, text: i.text + (a.val ? ` [${a.val} ${i.unit}]` : ''), note: a.note || 'Sin observación' }; });\n    const yn = (key, k) => { const v = c[key][k]; const set = x => () => this.setCur(cc => ({ [key]: { ...cc[key], [k]: v === x ? undefined : x } })); return { yes: set(true), no: set(false), ybg: v === true ? 'var(--color-text)' : 'transparent', yfg: v === true ? '#fff' : 'var(--color-text)', nbg: v === false ? 'var(--color-text)' : 'transparent', nfg: v === false ? '#fff' : 'var(--color-text)' }; };\n    const insDone = iv.insumos.filter((_, k) => c.ins[k] !== undefined).length;\n    return {\n      code: D.code, modelName: D.name, modelCode: D.code,\n      models: RD.models.map(x => ({ code: x.code, label: x.name + ' · ' + x.code.replace('CG-GA-PM-RS-', 'RS-') })),\n      onModel: e => { const nm = RD.models.find(x => x.code === e.target.value); if (!nm) return; this.ui.rows = {}; this.setState({ model: nm.code, interval: nm.intervals[st.interval] ? st.interval : Object.keys(nm.intervals)[0] }); },\n      interval: st.interval, total, doneCount, pct, tabs, sections, filters, fields, intervals,\n      emptyFilter: sections.length === 0, emptyMsg: ui.filter === 'pend' ? 'No quedan tareas pendientes.' : ui.filter === 'bad' ? 'Sin hallazgos registrados.' : '',\n      fixedData: [['Descripción', D.desc], ['Modelo', D.model], ['Ubicación', D.location], ['Duración estimada', iv.est + ' h']].map(([k, v]) => ({ k, v })),\n      isDatos: ui.tab !== 'check', isCheck: ui.tab === 'check', \n      goCheck: () => this.setUi({ tab: 'check' }), goCierre: () => this.setUi({ tab: 'cierre' }),\n      allGood: () => this.setCur(cc => { const ans = { ...cc.ans }; flat.forEach(i => { if (!(ans[i.id] || {}).s) ans[i.id] = { ...(ans[i.id] || {}), s: 'B' }; }); return { ans }; }),\n      pendingLabel: pending ? `${pending} pendientes` : 'completo',\n      summary: [['Bueno', cnt('B'), 'var(--color-bg)', 'var(--color-text)'], ['Regular', cnt('R'), 'var(--color-accent-200)', 'var(--color-accent-800)'], ['Malo', cnt('M'), 'var(--color-accent)', '#fff'], ['Pend.', pending, 'var(--color-neutral-200)', 'var(--color-text)']].map(([label, n, bg, fg]) => ({ label, n, bg, fg })),\n      findings, noFindings: findings.length === 0,\n      insCount: `${insDone} / ${iv.insumos.length}`,\n      insumos: iv.insumos.map(([pn, desc, q, u], k) => ({ pn, desc, qty: `${q} ${u}`.trim(), ...yn('ins', k) })),\n      tools: iv.tools.map(([desc, q], k) => ({ desc, qty: q, ...yn('tools', k) })),\n      obs: c.obs || '', onObs: e => { const v = e.target.value; this.setCur(() => ({ obs: v })); },\n      sigRef: this.sigRef, clearSig: () => { const cv = this._canvas; if (cv) cv.getContext('2d').clearRect(0, 0, cv.width, cv.height); this.setState({ sig: null }); },\n      signerLine: (m.ejecutor || 'Ejecutante') + (st.sig ? ' · firmado' : ' · firma con el dedo'),\n      exportPdf: () => this.exportPdf(D, iv, flat),\n      toast: ui.toast, toastOn: !!ui.toast && ui.tab === 'check'\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>
